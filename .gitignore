# Repo-wide ignores. The Next.js app has its own frontend/.gitignore —
# keep JS/Next rules there, not here.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# virtual environments
venv/
.venv/
env/
ENV/

# secrets
.env
.env.*
!.env.example

# scraper run artefacts (checked-in datasets under data/ are unaffected)
failed_ids.txt

# paid X API run output - each file is a run someone was billed for
x_posts_*.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# editors
.vscode/
.idea/
*.swp

# misc
*.pem
